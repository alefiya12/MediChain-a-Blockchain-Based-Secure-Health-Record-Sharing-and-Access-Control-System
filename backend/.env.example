# Backend Configuration — copy to .env and fill in real values
# NEVER commit the real .env file

PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/medichain
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRES_IN=7d
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
CONTRACT_ADDRESS=<deployed-contract-address>
FILE_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
FRONTEND_URL=http://localhost:5173

# Admin seed script values
ADMIN_EMAIL=admin@medichain.local
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_WALLET=<admin-polygon-wallet-address>

# Blockchain deployment (only needed for Hardhat scripts, NEVER for runtime)
DEPLOYER_PRIVATE_KEY=<deployer-private-key>
